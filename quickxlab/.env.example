APP_NAME="QuickTap POS"
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://quickxlab.com

APP_TIMEZONE=UTC
LOG_CHANNEL=daily
LOG_LEVEL=warning

# The same MySQL database billing-api used. Keep the prefix empty: the tables are the
# ones the till and the old panel already read (shops, licences, app_devices, …).
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=quicktap_billing
DB_USERNAME=quicktap
DB_PASSWORD=

SESSION_DRIVER=file
SESSION_LIFETIME=120
CACHE_STORE=file
QUEUE_CONNECTION=sync
FILESYSTEM_DISK=local

# --- the contract the APK and every web/desktop client depends on ---------------
# The build credential pair (X-App-Id / X-Api-Key). It must match app/build.gradle.
BILLING_APP_ID=app_41f7d123706a
BILLING_APP_API_KEY=
# Signs till session tokens. Rotate to sign every till out: php -r "echo bin2hex(random_bytes(32));"
BILLING_JWT_SECRET=
BILLING_JWT_TTL=7200
# The address the till caches as "last known good". Needs https and a trailing slash.
BILLING_API_BASE_URL=https://quickxlab.com/api/
# Trial days a brand new shop gets before the panel approves it (0 = wait for approval).
BILLING_TRIAL_DAYS=0
BILLING_DEFAULT_CURRENCY=PKR
# Exact origin of a site that is NOT this host; leave empty for same-origin pages.
BILLING_CORS_ORIGIN=
BILLING_SYNC_BATCH_LIMIT=500
BILLING_OFFLINE_GRACE_HOURS=24
# Only needed if you run billing-api's install.php against this app; leave empty otherwise.
BILLING_INSTALL_KEY=

# --- first-run content for `php artisan db:seed` (fills holes only, never overwrites) -----
# The panel login. A password shorter than 10 characters means "no admin user" on purpose:
# a default password on a public host is how a billing panel ends up in a search index.
SEED_ADMIN_USERNAME=quickadmin
SEED_ADMIN_PASSWORD=
SEED_APP_NAME="QuickTap POS"
SUPPORT_WHATSAPP=923114836011
SEED_MIN_APP_VERSION=1.3.0

# Set to true to append every query and its timing to storage/logs/laravel.log — the way to
# find out whether a slow panel is the app or the sync_records scan.
DB_QUERY_LOG=false

# Firebase is only what the app needs for push + remote config; empty is fine.
FIREBASE_APP_ID=
FIREBASE_API_KEY=
FIREBASE_PROJECT_ID=
FIREBASE_SENDER_ID=

MAIL_MAILER=log
MAIL_FROM_ADDRESS="no-reply@quickxlab.com"
MAIL_FROM_NAME="${APP_NAME}"
