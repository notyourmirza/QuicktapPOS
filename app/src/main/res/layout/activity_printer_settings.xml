<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:fitsSystemWindows="true">

    <com.google.android.material.appbar.MaterialToolbar
        android:id="@+id/toolbar"
        android:layout_width="match_parent"
        android:layout_height="?attr/actionBarSize"
        app:navigationIcon="@drawable/ic_back"
        app:title="Printer" />

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="20dp">

            <com.google.android.material.card.MaterialCardView
                android:id="@+id/receiptPreviewCard"
                style="@style/CardPremium"
                android:layout_width="match_parent"
                android:layout_height="wrap_content">
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="14dp">
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">
                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="Receipt preview"
                            android:textStyle="bold" />
                        <com.google.android.material.materialswitch.MaterialSwitch
                            android:id="@+id/switchReceiptPreview"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Show" />
                    </LinearLayout>
                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="2dp"
                        android:text="Preview matches the selected print design, logo and receipt fields."
                        android:textSize="12sp" />
                    <ImageView
                        android:id="@+id/previewLogo"
                        android:layout_width="92dp"
                        android:layout_height="48dp"
                        android:layout_gravity="center_horizontal"
                        android:layout_marginTop="8dp"
                        android:adjustViewBounds="true"
                        android:scaleType="centerInside"
                        android:contentDescription="Restaurant logo preview" />
                    <TextView
                        android:id="@+id/previewReceipt"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="6dp"
                        android:background="@color/white"
                        android:fontFamily="monospace"
                        android:gravity="center_horizontal"
                        android:padding="10dp"
                        android:textColor="@color/text_primary"
                        android:textSize="10sp" />
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="14dp"
                        android:text="Receipt design"
                        android:textStyle="bold" />
                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="2dp"
                        android:text="Select a design and it will be saved as default. Logo, order type, payment and note stay visible."
                        android:textSize="12sp" />
                    <Spinner
                        android:id="@+id/spinnerReceiptDesign"
                        android:layout_width="match_parent"
                        android:layout_height="52dp"
                        android:layout_marginTop="6dp"
                        android:backgroundTint="@color/brand_primary"
                        android:spinnerMode="dropdown" />
                    <com.google.android.material.textfield.TextInputLayout
                        style="@style/Input.QuickTap"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="10dp"
                        android:hint="Receipt template code (optional)">
                        <com.google.android.material.textfield.TextInputEditText
                            android:id="@+id/inputReceiptTemplateCode"
                            android:layout_width="match_parent"
                            android:layout_height="150dp"
                            android:gravity="top|start"
                            android:fontFamily="monospace"
                            android:inputType="textMultiLine" />
                    </com.google.android.material.textfield.TextInputLayout>
                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:text="Tokens: {STORE_NAME} {INVOICE} {DATE} {ORDER_TYPE} {PAYMENT} {STATUS} {ITEMS} {SUBTOTAL} {DISCOUNT} {TAX} {TOTAL} {NOTE} {FOOTER}. Empty code uses the selected design."
                        android:textSize="11sp" />
                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/buttonSaveReceiptTemplateCode"
                        style="@style/Widget.Material3.Button.OutlinedButton"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="6dp"
                        android:text="Save receipt code" />
                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/buttonRefreshPreview"
                        style="@style/Widget.Material3.Button.OutlinedButton"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:text="Refresh preview" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- Currently saved printer, whatever the transport -->
            <com.google.android.material.card.MaterialCardView
                style="@style/CardPremium"
                android:layout_width="match_parent"
                android:layout_height="wrap_content">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="14dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Selected printer"
                        style="@style/Caption" />

                    <TextView
                        android:id="@+id/textSelectedSummary"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="2dp"
                        android:textAppearance="@style/TextAppearance.QuickTap.Title"
                        android:textColor="?attr/colorOnSurface" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                android:text="Paper width"
                android:textStyle="bold" />

            <RadioGroup
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal">

                <RadioButton
                    android:id="@+id/radio58"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="58 mm" />

                <RadioButton
                    android:id="@+id/radio80"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="24dp"
                    android:text="80 mm" />
            </RadioGroup>

            <!-- ============ Bluetooth ============ -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="26dp"
                android:text="Bluetooth printer"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/textBluetoothHint"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:textColor="?attr/colorOnSurfaceVariant" />

            <LinearLayout
                android:id="@+id/containerBluetoothDevices"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:orientation="vertical" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/buttonRefreshBluetooth"
                style="@style/Widget.Material3.Button.OutlinedButton"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:text="Refresh paired devices" />

            <!-- ============ USB ============ -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="26dp"
                android:text="USB printer"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/textUsbHint"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:textColor="?attr/colorOnSurfaceVariant" />

            <LinearLayout
                android:id="@+id/containerUsbDevices"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:orientation="vertical" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/buttonRefreshUsb"
                style="@style/Widget.Material3.Button.OutlinedButton"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:text="Scan USB devices" />

            <!-- ============ Network ============ -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="26dp"
                android:text="Network (Wi-Fi / LAN) printer"
                android:textStyle="bold" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:text="Enter the printer's IP address and port (default 9100)."
                android:textColor="?attr/colorOnSurfaceVariant" />

            <com.google.android.material.textfield.TextInputLayout
                style="@style/Input.QuickTap"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:hint="IP address">

                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/inputNetHost"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:inputType="text" />
            </com.google.android.material.textfield.TextInputLayout>

            <com.google.android.material.textfield.TextInputLayout
                style="@style/Input.QuickTap"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:hint="Port">

                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/inputNetPort"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:inputType="number"
                    android:text="9100" />
            </com.google.android.material.textfield.TextInputLayout>

            <com.google.android.material.button.MaterialButton
                android:id="@+id/buttonSaveNetwork"
                style="@style/Widget.Material3.Button.OutlinedButton"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:text="Save network printer" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/buttonTestPrint"
                style="@style/BigButton"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="26dp"
                app:icon="@drawable/ic_print"
                android:text="Test print" />
        </LinearLayout>
    </ScrollView>
</LinearLayout>
