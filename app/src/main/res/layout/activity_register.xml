<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/white">

    <View
        android:layout_width="190dp"
        android:layout_height="190dp"
        android:layout_gravity="top|start"
        android:layout_marginStart="-84dp"
        android:layout_marginTop="-86dp"
        android:background="@drawable/bg_login_orange_blob" />
    <View
        android:layout_width="150dp"
        android:layout_height="150dp"
        android:layout_gravity="top|end"
        android:layout_marginTop="-74dp"
        android:layout_marginEnd="-80dp"
        android:alpha="0.78"
        android:background="@drawable/bg_login_orange_blob_light" />

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fillViewport="true"
        android:overScrollMode="never"
        android:scrollbars="none">
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_horizontal"
            android:orientation="vertical"
            android:paddingHorizontal="22dp"
            android:paddingTop="18dp"
            android:paddingBottom="18dp">

            <ImageView
                android:layout_width="118dp"
                android:layout_height="84dp"
                android:importantForAccessibility="no"
                android:scaleType="fitCenter"
                android:src="@drawable/logo_user_supplied_exact" />
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="5dp"
                android:gravity="center"
                android:text="Create Your Account"
                android:textColor="#101A3A"
                android:textSize="23sp"
                android:textStyle="bold" />
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="3dp"
                android:gravity="center"
                android:text="One account per device  •  Admin approval required"
                android:textColor="#626773"
                android:textSize="12sp" />

            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="18dp"
                app:cardBackgroundColor="@color/white"
                app:cardCornerRadius="20dp"
                app:cardElevation="4dp"
                app:strokeColor="#F0F0F0"
                app:strokeWidth="1dp">
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="12dp">
                    <com.google.android.material.textfield.TextInputLayout
                        android:id="@+id/layoutShop" style="@style/Input.QuickTap"
                        android:layout_width="match_parent" android:layout_height="60dp" android:hint="Shop name"
                        app:boxCornerRadiusBottomEnd="15dp" app:boxCornerRadiusBottomStart="15dp" app:boxCornerRadiusTopEnd="15dp" app:boxCornerRadiusTopStart="15dp" app:boxStrokeColor="@color/brand_primary">
                        <com.google.android.material.textfield.TextInputEditText android:id="@+id/inputShop" android:layout_width="match_parent" android:layout_height="wrap_content" android:minHeight="48dp" android:gravity="center_vertical" android:includeFontPadding="true" android:paddingTop="8dp" android:paddingBottom="8dp" android:imeOptions="actionNext" android:inputType="textCapWords" android:textSize="15sp" />
                    </com.google.android.material.textfield.TextInputLayout>
                    <com.google.android.material.textfield.TextInputLayout
                        android:id="@+id/layoutOwner" style="@style/Input.QuickTap"
                        android:layout_width="match_parent" android:layout_height="60dp" android:layout_marginTop="8dp" android:hint="Owner name (optional)"
                        app:boxCornerRadiusBottomEnd="15dp" app:boxCornerRadiusBottomStart="15dp" app:boxCornerRadiusTopEnd="15dp" app:boxCornerRadiusTopStart="15dp" app:boxStrokeColor="@color/brand_primary">
                        <com.google.android.material.textfield.TextInputEditText android:id="@+id/inputOwner" android:layout_width="match_parent" android:layout_height="wrap_content" android:minHeight="48dp" android:gravity="center_vertical" android:includeFontPadding="true" android:paddingTop="8dp" android:paddingBottom="8dp" android:imeOptions="actionNext" android:inputType="textCapWords" android:textSize="15sp" />
                    </com.google.android.material.textfield.TextInputLayout>
                    <com.google.android.material.textfield.TextInputLayout
                        android:id="@+id/layoutPhone" style="@style/Input.QuickTap"
                        android:layout_width="match_parent" android:layout_height="60dp" android:layout_marginTop="8dp" android:hint="WhatsApp number (optional)"
                        app:boxCornerRadiusBottomEnd="15dp" app:boxCornerRadiusBottomStart="15dp" app:boxCornerRadiusTopEnd="15dp" app:boxCornerRadiusTopStart="15dp" app:boxStrokeColor="@color/brand_primary">
                        <com.google.android.material.textfield.TextInputEditText android:id="@+id/inputPhone" android:layout_width="match_parent" android:layout_height="wrap_content" android:minHeight="48dp" android:gravity="center_vertical" android:includeFontPadding="true" android:paddingTop="8dp" android:paddingBottom="8dp" android:imeOptions="actionNext" android:inputType="phone" android:textSize="15sp" />
                    </com.google.android.material.textfield.TextInputLayout>
                    <com.google.android.material.textfield.TextInputLayout
                        android:id="@+id/layoutUsername" style="@style/Input.QuickTap"
                        android:layout_width="match_parent" android:layout_height="60dp" android:layout_marginTop="8dp" android:hint="Username"
                        app:boxCornerRadiusBottomEnd="15dp" app:boxCornerRadiusBottomStart="15dp" app:boxCornerRadiusTopEnd="15dp" app:boxCornerRadiusTopStart="15dp" app:boxStrokeColor="@color/brand_primary">
                        <com.google.android.material.textfield.TextInputEditText android:id="@+id/inputUsername" android:layout_width="match_parent" android:layout_height="wrap_content" android:minHeight="48dp" android:gravity="center_vertical" android:includeFontPadding="true" android:paddingTop="8dp" android:paddingBottom="8dp" android:imeOptions="actionNext" android:inputType="text" android:textSize="15sp" />
                    </com.google.android.material.textfield.TextInputLayout>
                    <com.google.android.material.textfield.TextInputLayout
                        android:id="@+id/layoutPassword" style="@style/Input.QuickTap"
                        android:layout_width="match_parent" android:layout_height="60dp" android:layout_marginTop="8dp" android:hint="Password" app:endIconMode="password_toggle"
                        app:boxCornerRadiusBottomEnd="15dp" app:boxCornerRadiusBottomStart="15dp" app:boxCornerRadiusTopEnd="15dp" app:boxCornerRadiusTopStart="15dp" app:boxStrokeColor="@color/brand_primary">
                        <com.google.android.material.textfield.TextInputEditText android:id="@+id/inputPassword" android:layout_width="match_parent" android:layout_height="wrap_content" android:minHeight="48dp" android:gravity="center_vertical" android:includeFontPadding="true" android:paddingTop="8dp" android:paddingBottom="8dp" android:imeOptions="actionNext" android:inputType="textPassword" android:textSize="15sp" />
                    </com.google.android.material.textfield.TextInputLayout>
                    <com.google.android.material.textfield.TextInputLayout
                        android:id="@+id/layoutConfirm" style="@style/Input.QuickTap"
                        android:layout_width="match_parent" android:layout_height="60dp" android:layout_marginTop="8dp" android:hint="Confirm password" app:endIconMode="password_toggle"
                        app:boxCornerRadiusBottomEnd="15dp" app:boxCornerRadiusBottomStart="15dp" app:boxCornerRadiusTopEnd="15dp" app:boxCornerRadiusTopStart="15dp" app:boxStrokeColor="@color/brand_primary">
                        <com.google.android.material.textfield.TextInputEditText android:id="@+id/inputConfirm" android:layout_width="match_parent" android:layout_height="wrap_content" android:minHeight="48dp" android:gravity="center_vertical" android:includeFontPadding="true" android:paddingTop="8dp" android:paddingBottom="8dp" android:imeOptions="actionDone" android:inputType="textPassword" android:textSize="15sp" />
                    </com.google.android.material.textfield.TextInputLayout>
                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/buttonCreate" style="@style/BigButton"
                        android:layout_width="match_parent" android:layout_height="48dp" android:layout_marginTop="10dp" android:text="Create Account" android:textSize="14sp" app:cornerRadius="14dp" />
                    <LinearLayout android:layout_width="match_parent" android:layout_height="44dp" android:layout_marginTop="8dp" android:orientation="horizontal">
                        <com.google.android.material.button.MaterialButton android:id="@+id/buttonHaveAccount" style="@style/Button.QuickTap.Outlined" android:layout_width="0dp" android:layout_height="match_parent" android:layout_marginEnd="5dp" android:layout_weight="1" android:text="I have an account" android:textSize="11sp" app:cornerRadius="12dp" />
                        <com.google.android.material.button.MaterialButton android:id="@+id/buttonContact" style="@style/Button.QuickTap.Outlined" android:layout_width="0dp" android:layout_height="match_parent" android:layout_marginStart="5dp" android:layout_weight="1" android:text="Contact admin" android:textSize="11sp" app:cornerRadius="12dp" />
                    </LinearLayout>
                    <ProgressBar android:id="@+id/progress" android:layout_width="wrap_content" android:layout_height="22dp" android:layout_gravity="center" android:layout_marginTop="6dp" android:indeterminateTint="@color/brand_primary" android:visibility="gone" />
                    <TextView android:id="@+id/textStatus" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="5dp" android:background="@drawable/bg_pill_danger" android:padding="8dp" android:textColor="?attr/colorError" android:textSize="11sp" android:visibility="gone" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>
            <TextView android:id="@+id/textDevice" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="9dp" android:gravity="center" android:textColor="#767983" android:textSize="10sp" />
        </LinearLayout>
    </ScrollView>
</FrameLayout>
