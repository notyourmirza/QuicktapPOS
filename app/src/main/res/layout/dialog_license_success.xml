<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    style="@style/CardPremium"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_margin="20dp">
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_horizontal"
        android:orientation="vertical"
        android:padding="20dp">
        <FrameLayout android:layout_width="64dp" android:layout_height="64dp" android:background="@drawable/bg_pill_light">
            <ImageView android:layout_width="38dp" android:layout_height="38dp" android:layout_gravity="center" android:importantForAccessibility="no" android:src="@drawable/ic_shield_check" app:tint="?attr/colorPrimary" />
        </FrameLayout>
        <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="10dp" android:gravity="center" android:text="License Activated" android:textColor="?attr/colorOnSurface" android:textSize="21sp" android:textStyle="bold" />
        <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="4dp" android:gravity="center" android:text="Your QuickTap account is ready to use." android:textColor="?attr/colorOnSurfaceVariant" android:textSize="13sp" />
        <TextView android:id="@+id/textDuration" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="13dp" android:background="@drawable/bg_pill_light" android:gravity="center" android:padding="11dp" android:textColor="?attr/colorPrimary" android:textSize="15sp" android:textStyle="bold" />
        <TextView android:id="@+id/textExpiry" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="6dp" android:gravity="center" android:textColor="?attr/colorOnSurfaceVariant" android:textSize="11sp" android:visibility="gone" />
        <com.google.android.material.button.MaterialButton android:id="@+id/buttonContinue" style="@style/BigButton" android:layout_width="match_parent" android:layout_height="48dp" android:layout_marginTop="15dp" android:text="Continue" />
    </LinearLayout>
</com.google.android.material.card.MaterialCardView>
