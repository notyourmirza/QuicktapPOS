<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto" android:layout_width="match_parent" android:layout_height="match_parent" android:orientation="vertical" android:background="#FFFFFF">
    <LinearLayout android:id="@+id/dashboardHeader" android:layout_width="match_parent" android:layout_height="82dp" android:gravity="center_vertical" android:orientation="horizontal" android:paddingStart="18dp" android:paddingEnd="10dp" android:background="#FF5A00">
        <ImageView android:layout_width="42dp" android:layout_height="42dp" android:padding="7dp" android:src="@drawable/ic_customer_account" android:contentDescription="Customer account" />
        <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:orientation="vertical" android:paddingStart="8dp">
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Customer Account Dashboard" android:textColor="#FFFFFF" android:textSize="20sp" android:textStyle="bold" />
            <TextView android:id="@+id/textDashboardCustomer" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="2dp" android:textColor="#FFF3EA" android:textSize="14sp" android:maxLines="1" android:ellipsize="end" />
        </LinearLayout>
        <com.google.android.material.button.MaterialButton android:id="@+id/buttonDashboardClose" style="@style/Widget.Material3.Button.IconButton" android:layout_width="46dp" android:layout_height="46dp" android:minWidth="0dp" android:textColor="#FFFFFF" android:textSize="24sp" android:backgroundTint="#22FFFFFF" app:icon="@drawable/ic_popup_close" android:contentDescription="Close dashboard" />
    </LinearLayout>
    <LinearLayout android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" android:orientation="vertical" android:padding="16dp">
        <com.google.android.material.card.MaterialCardView android:layout_width="match_parent" android:layout_height="wrap_content" app:cardBackgroundColor="#F8FAFC" app:cardCornerRadius="16dp" app:strokeColor="#E7E7E7" app:strokeWidth="1dp">
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:padding="15dp">
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="CURRENT OUTSTANDING" android:textColor="#475569" android:textSize="13sp" android:textStyle="bold" />
                <TextView android:id="@+id/textDashboardOutstanding" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="3dp" android:textColor="#D32F2F" android:textSize="27sp" android:textStyle="bold" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>
        <LinearLayout android:layout_width="match_parent" android:layout_height="54dp" android:layout_marginTop="10dp" android:orientation="horizontal">
            <com.google.android.material.button.MaterialButton android:id="@+id/buttonDashboardReceive" android:layout_width="0dp" android:layout_height="match_parent" android:layout_marginEnd="5dp" android:layout_weight="1" android:text="RECEIVE" app:icon="@drawable/ic_receive_money" android:textColor="#FFFFFF" android:textSize="14sp" android:textStyle="bold" android:backgroundTint="#16A34A" app:cornerRadius="14dp" />
            <com.google.android.material.button.MaterialButton android:id="@+id/buttonDashboardDeduct" android:layout_width="0dp" android:layout_height="match_parent" android:layout_marginStart="5dp" android:layout_weight="1" android:text="DEDUCT" app:icon="@drawable/ic_deduct_money" android:textColor="#E94E00" android:textSize="14sp" android:textStyle="bold" android:backgroundTint="#FFFFFF" app:cornerRadius="14dp" app:strokeColor="#FF5A00" app:strokeWidth="2dp" />
        </LinearLayout>
        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="13dp" android:text="Statement Period" android:drawableStart="@drawable/ic_statement_calendar" android:drawablePadding="8dp" android:textColor="#111827" android:textSize="17sp" android:textStyle="bold" />
        <LinearLayout android:layout_width="match_parent" android:layout_height="50dp" android:layout_marginTop="6dp" android:orientation="horizontal">
            <com.google.android.material.button.MaterialButton android:id="@+id/buttonDashboardFrom" style="@style/Button.QuickTap.Outlined" android:layout_width="0dp" android:layout_height="match_parent" android:layout_marginEnd="5dp" android:layout_weight="1" android:textColor="#111827" android:textSize="13sp" app:cornerRadius="13dp" app:strokeColor="#FFD8C2" />
            <com.google.android.material.button.MaterialButton android:id="@+id/buttonDashboardTo" style="@style/Button.QuickTap.Outlined" android:layout_width="0dp" android:layout_height="match_parent" android:layout_marginStart="5dp" android:layout_weight="1" android:textColor="#111827" android:textSize="13sp" app:cornerRadius="13dp" app:strokeColor="#FFD8C2" />
        </LinearLayout>
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="10dp" android:orientation="horizontal">
            <TextView android:id="@+id/textStatCredit" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_marginEnd="2dp" android:layout_weight="1" android:padding="8dp" android:background="#ECFDF5" android:textColor="#111827" android:textSize="11sp" />
            <TextView android:id="@+id/textStatReceived" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_marginHorizontal="2dp" android:layout_weight="1" android:padding="8dp" android:background="#EFF6FF" android:textColor="#111827" android:textSize="11sp" />
            <TextView android:id="@+id/textStatDeducted" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_marginHorizontal="2dp" android:layout_weight="1" android:padding="8dp" android:background="#FFF1F2" android:textColor="#111827" android:textSize="11sp" />
            <TextView android:id="@+id/textStatTransactions" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_marginStart="2dp" android:layout_weight="1" android:padding="8dp" android:background="#FFF7ED" android:textColor="#111827" android:textSize="11sp" />
        </LinearLayout>
        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="12dp" android:text="Transactions" android:drawableStart="@drawable/ic_ledger_transactions" android:drawablePadding="8dp" android:textColor="#111827" android:textSize="17sp" android:textStyle="bold" />
        <androidx.core.widget.NestedScrollView android:id="@+id/transactionsScroll" android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" android:layout_marginTop="5dp" android:fillViewport="false" android:overScrollMode="ifContentScrolls">
            <LinearLayout android:id="@+id/dashboardTransactions" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" />
        </androidx.core.widget.NestedScrollView>
    </LinearLayout>
    <LinearLayout android:layout_width="match_parent" android:layout_height="60dp" android:orientation="horizontal" android:paddingStart="16dp" android:paddingEnd="16dp" android:paddingTop="5dp" android:paddingBottom="8dp" android:elevation="8dp" android:background="#FFFFFF">
        <com.google.android.material.button.MaterialButton android:id="@+id/buttonDashboardExport" style="@style/Button.QuickTap.Outlined" android:layout_width="0dp" android:layout_height="match_parent" android:layout_marginEnd="5dp" android:layout_weight="1" android:text="Export PDF" app:icon="@drawable/ic_statement_pdf" android:textColor="#E94E00" android:textSize="13sp" android:textStyle="bold" app:cornerRadius="13dp" app:strokeColor="#FF5A00" app:strokeWidth="2dp" />
        <com.google.android.material.button.MaterialButton android:id="@+id/buttonDashboardCloseBottom" style="@style/BigButton.Accent" android:layout_width="0dp" android:layout_height="match_parent" android:layout_marginStart="5dp" android:layout_weight="1" android:text="Close" app:icon="@drawable/ic_popup_close" android:textSize="13sp" android:textStyle="bold" app:cornerRadius="13dp" />
    </LinearLayout>
</LinearLayout>
