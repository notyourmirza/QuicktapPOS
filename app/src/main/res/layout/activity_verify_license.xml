<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_login_aurora"
    android:fitsSystemWindows="true"
    android:gravity="center_horizontal"
    android:orientation="vertical"
    android:paddingHorizontal="22dp"
    android:paddingTop="40dp"
    android:paddingBottom="16dp">
    <FrameLayout android:layout_width="72dp" android:layout_height="72dp" android:background="@drawable/bg_logo_badge_light">
        <ImageView android:layout_width="38dp" android:layout_height="38dp" android:layout_gravity="center" android:importantForAccessibility="no" android:src="@drawable/ic_shield_check" app:tint="@color/brand_primary" />
    </FrameLayout>
    <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="12dp" android:gravity="center" android:text="Verify Your License" android:textAppearance="@style/TextAppearance.QuickTap.Display" android:textColor="@color/white" android:textSize="25sp" />
    <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="3dp" android:gravity="center" android:text="Enter the license key issued by your administrator." android:textColor="@color/text_muted" android:textSize="12sp" />
    <com.google.android.material.card.MaterialCardView style="@style/CardPremium" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="16dp">
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:padding="14dp">
            <com.google.android.material.textfield.TextInputLayout android:id="@+id/layoutKey" style="@style/Input.QuickTap" android:layout_width="match_parent" android:layout_height="56dp" android:hint="License key">
                <com.google.android.material.textfield.TextInputEditText android:id="@+id/inputKey" android:layout_width="match_parent" android:layout_height="wrap_content" android:imeOptions="actionDone" android:inputType="textCapCharacters" android:maxLines="1" />
            </com.google.android.material.textfield.TextInputLayout>
            <com.google.android.material.button.MaterialButton android:id="@+id/buttonVerify" style="@style/BigButton" android:layout_width="match_parent" android:layout_height="50dp" android:layout_marginTop="10dp" android:text="Verify License" />
            <LinearLayout android:layout_width="match_parent" android:layout_height="44dp" android:layout_marginTop="6dp" android:orientation="horizontal">
                <com.google.android.material.button.MaterialButton android:id="@+id/buttonBack" style="@style/Button.QuickTap.Outlined" android:layout_width="0dp" android:layout_height="match_parent" android:layout_marginEnd="4dp" android:layout_weight="1" android:text="Back" android:textSize="12sp" />
                <com.google.android.material.button.MaterialButton android:id="@+id/buttonContact" style="@style/Button.QuickTap.Outlined" android:layout_width="0dp" android:layout_height="match_parent" android:layout_marginStart="4dp" android:layout_weight="1" android:text="Contact admin" android:textSize="12sp" />
            </LinearLayout>
            <ProgressBar android:id="@+id/progress" android:layout_width="wrap_content" android:layout_height="22dp" android:layout_gravity="center" android:layout_marginTop="5dp" android:indeterminateTint="?attr/colorPrimary" android:visibility="gone" />
            <TextView android:id="@+id/textStatus" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="5dp" android:background="@drawable/bg_pill_danger" android:padding="8dp" android:textColor="?attr/colorError" android:textSize="12sp" android:visibility="gone" />
        </LinearLayout>
    </com.google.android.material.card.MaterialCardView>
    <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="12dp" android:gravity="center" android:text="Secure activation · MA Technologies" android:textColor="@color/text_muted" android:textSize="10sp" />
</LinearLayout>
