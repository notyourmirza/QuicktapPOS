<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" android:id="@+id/navHeaderRoot" android:layout_width="match_parent" android:layout_height="wrap_content" android:background="#FF5A00" android:orientation="vertical" android:paddingStart="20dp" android:paddingTop="22dp" android:paddingEnd="20dp" android:paddingBottom="20dp">
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="center_vertical" android:orientation="horizontal">
        <FrameLayout android:layout_width="66dp" android:layout_height="66dp" android:background="@drawable/bg_drawer_logo_ring">
            <ImageView android:id="@+id/headerAvatar" android:layout_width="54dp" android:layout_height="54dp" android:layout_gravity="center" android:importantForAccessibility="no" android:scaleType="fitCenter" android:src="@drawable/logo_user_supplied_exact" />
        </FrameLayout>
        <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_marginStart="13dp" android:layout_weight="1" android:orientation="vertical">
            <TextView android:id="@+id/headerStore" android:layout_width="match_parent" android:layout_height="wrap_content" android:ellipsize="end" android:maxLines="1" android:text="QuickTap POS" android:textColor="#FFFFFF" android:textSize="20sp" android:textStyle="bold" />
            <TextView android:id="@+id/headerUser" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="3dp" android:ellipsize="end" android:maxLines="1" android:textColor="#FFF1E8" android:textSize="12sp" />
        </LinearLayout>
    </LinearLayout>
    <TextView android:id="@+id/headerLicenseDays" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="17dp" android:background="#33FFFFFF" android:paddingStart="12dp" android:paddingTop="6dp" android:paddingEnd="12dp" android:paddingBottom="6dp" android:text="License status" android:textColor="#FFFFFF" android:textSize="11sp" android:textStyle="bold" />
    <TextView android:id="@+id/headerPlan" android:visibility="gone" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="8dp" android:text="Active plan" android:textColor="#FFFFFF" android:textSize="11sp" android:textStyle="bold" />
</LinearLayout>
