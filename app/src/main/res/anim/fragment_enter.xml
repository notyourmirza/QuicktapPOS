<?xml version="1.0" encoding="utf-8"?>
<set xmlns:android="http://schemas.android.com/apk/res/android"
    android:interpolator="@android:interpolator/fast_out_slow_in">
    <alpha android:fromAlpha="0" android:toAlpha="1" android:duration="260" />
    <translate android:fromYDelta="3%p" android:toYDelta="0" android:duration="300" />
    <scale android:fromXScale="0.99" android:toXScale="1" android:fromYScale="0.99" android:toYScale="1"
        android:pivotX="50%" android:pivotY="40%" android:duration="300" />
</set>
