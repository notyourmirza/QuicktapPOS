<resources>
    <!-- ============================================================
         QuickTap POS — night palette.
         Same two-colour language as day mode (one emerald accent on a
         neutral surface stack), inverted: ink surfaces, paper text.
         The accent stays runtime-overridable by the Super Admin.
         ============================================================ -->

    <!-- Brand (runtime-overridable) — lifted for contrast on dark ink -->
    <color name="brand_primary">#FF7043</color>
    <color name="brand_primary_dark">#FFAB91</color>
    <color name="brand_primary_soft">#4E1C0C</color>
    <color name="brand_secondary">#FF7043</color>
    <color name="brand_secondary_soft">#4E1C0C</color>
    <color name="brand_accent">#FF7043</color>
    <color name="brand_accent_soft">#4E1C0C</color>

    <!-- Surfaces -->
    <color name="app_background">#10151F</color>
    <color name="app_surface">#18212D</color>
    <color name="app_surface_muted">#263445</color>
    <color name="app_outline">#334155</color>
    <color name="app_outline_soft">#263445</color>

    <!-- Text -->
    <color name="text_primary">#F7F6F0</color>
    <color name="text_muted">#AAB6C5</color>
    <color name="text_on_brand">#10151F</color>

