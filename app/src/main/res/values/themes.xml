<?xml version="1.0" encoding="utf-8"?>
<resources xmlns:tools="http://schemas.android.com/tools">

    <!--
      QuickTap POS design system — "Paper & Cobalt".
      Flat surfaces, hairline outlines, one accent, no gradients and no
      elevation. Every brand colour here is a default: 类037 repaints
      the accent at runtime with the colour set in the Super Admin panel.
    -->

    <!-- ============================ THEME ============================ -->
    <style name="Theme.QuickTap" parent="Theme.Material3.DayNight.NoActionBar">
        <item name="colorPrimary">@color/brand_primary</item>
        <item name="colorOnPrimary">@color/text_on_brand</item>
        <item name="colorPrimaryContainer">@color/brand_primary_soft</item>
        <item name="colorOnPrimaryContainer">@color/brand_primary_dark</item>
        <item name="colorSecondary">@color/brand_secondary</item>
        <item name="colorOnSecondary">@color/text_on_brand</item>
        <item name="colorSecondaryContainer">@color/brand_secondary_soft</item>
        <item name="colorOnSecondaryContainer">@color/brand_primary_dark</item>
        <item name="colorTertiary">@color/text_primary</item>
        <item name="colorOnTertiary">@color/white</item>
        <item name="colorTertiaryContainer">@color/brand_accent_soft</item>
        <item name="colorOnTertiaryContainer">@color/text_primary</item>

        <item name="colorError">@color/danger</item>
        <item name="colorErrorContainer">@color/danger_soft</item>

        <item name="android:colorBackground">@color/app_background</item>
        <item name="colorOnBackground">@color/text_primary</item>
        <item name="colorSurface">@color/app_surface</item>
        <item name="colorOnSurface">@color/text_primary</item>
        <item name="colorSurfaceVariant">@color/app_surface_muted</item>
        <item name="colorOnSurfaceVariant">@color/text_muted</item>
        <item name="colorSurfaceContainerLow">@color/app_surface</item>
        <item name="colorSurfaceContainer">@color/app_surface_muted</item>
        <item name="colorOutline">@color/app_outline</item>
        <item name="colorOutlineVariant">@color/app_outline_soft</item>
        <item name="android:textColorPrimary">@color/text_primary</item>
        <item name="android:textColorSecondary">@color/text_muted</item>

        <item name="android:statusBarColor">@color/app_background</item>
        <item name="android:navigationBarColor">@color/app_background</item>
        <item name="android:windowLightStatusBar" tools:targetApi="m">@bool/light_system_bars</item>
        <item name="android:windowLightNavigationBar" tools:targetApi="o_mr1">@bool/light_system_bars</item>

        <!-- Shape language: restrained, near-square corners -->
        <item name="shapeAppearanceCornerSmall">@style/Shape.QuickTap.Small</item>
        <item name="shapeAppearanceCornerMedium">@style/Shape.QuickTap.Medium</item>
        <item name="shapeAppearanceCornerLarge">@style/Shape.QuickTap.Large</item>

        <!-- Typography -->
        <item name="textAppearanceHeadlineSmall">@style/TextAppearance.QuickTap.Headline</item>
        <item name="textAppearanceTitleMedium">@style/TextAppearance.QuickTap.Title</item>
        <item name="textAppearanceLabelLarge">@style/TextAppearance.QuickTap.Label</item>

        <!-- Component defaults -->
        <item name="materialCardViewStyle">@style/CardPremium</item>
        <item name="bottomNavigationStyle">@style/BottomNav.QuickTap</item>
        <item name="materialButtonStyle">@style/Button.QuickTap</item>
        <item name="materialButtonOutlinedStyle">@style/Button.QuickTap.Outlined</item>
        <item name="textInputStyle">@style/Input.QuickTap</item>
        <item name="chipStyle">@style/Chip.QuickTap</item>
    </style>

    <style name="Theme.QuickTap.Splash" parent="Theme.QuickTap">
        <item name="android:windowBackground">@color/brand_primary</item>
        <item name="android:statusBarColor">@color/white</item>
        <item name="android:navigationBarColor">@color/white</item>
        <item name="android:windowLightStatusBar" tools:targetApi="m">true</item>
        <item name="android:windowLightNavigationBar" tools:targetApi="o_mr1">true</item>
    </style>

    <!-- ============================ SHAPES ============================ -->
    <style name="Shape.QuickTap.Small" parent="ShapeAppearance.Material3.Corner.Small">
        <item name="cornerSize">10dp</item>
    </style>

    <style name="Shape.QuickTap.Medium" parent="ShapeAppearance.Material3.Corner.Medium">
        <item name="cornerSize">14dp</item>
    </style>

    <style name="Shape.QuickTap.Large" parent="ShapeAppearance.Material3.Corner.Large">
        <item name="cornerSize">18dp</item>
    </style>

    <style name="Shape.QuickTap.Pill" parent="ShapeAppearance.Material3.Corner.Full">
        <item name="cornerSize">999dp</item>
    </style>

    <!-- ========================== TYPOGRAPHY ========================== -->
    <style name="TextAppearance.QuickTap.Display" parent="TextAppearance.Material3.HeadlineMedium">
        <item name="android:fontFamily">sans-serif-medium</item>
        <item name="android:textStyle">bold</item>
        <item name="android:letterSpacing">-0.03</item>
        <item name="android:textSize">30sp</item>
    </style>

    <style name="TextAppearance.QuickTap.Headline" parent="TextAppearance.Material3.HeadlineSmall">
        <item name="android:fontFamily">sans-serif-medium</item>
        <item name="android:textStyle">bold</item>
        <item name="android:letterSpacing">-0.02</item>
        <item name="android:textSize">23sp</item>
    </style>

    <style name="TextAppearance.QuickTap.Title" parent="TextAppearance.Material3.TitleMedium">
        <item name="android:fontFamily">sans-serif-medium</item>
        <item name="android:textStyle">bold</item>
        <item name="android:letterSpacing">-0.01</item>
        <item name="android:textSize">20sp</item>
    </style>

    <style name="TextAppearance.QuickTap.Label" parent="TextAppearance.Material3.LabelLarge">
        <item name="android:fontFamily">sans-serif-medium</item>
        <item name="android:textStyle">bold</item>
        <item name="android:letterSpacing">0.01</item>
    </style>

    <style name="TextAppearance.QuickTap.Overline" parent="TextAppearance.Material3.LabelSmall">
        <item name="android:fontFamily">sans-serif-medium</item>
        <item name="android:letterSpacing">0.08</item>
        <item name="android:textAllCaps">true</item>
        <item name="android:textSize">10sp</item>
    </style>

    <style name="TextAppearance.QuickTap.类053" parent="TextAppearance.Material3.TitleLarge">
        <item name="android:fontFamily">sans-serif-medium</item>
        <item name="android:textStyle">bold</item>
        <item name="android:letterSpacing">-0.03</item>
    </style>

    <!-- Convenience widget styles -->
    <style name="ScreenTitle">
        <item name="android:textAppearance">@style/TextAppearance.QuickTap.Headline</item>
        <item name="android:textColor">?attr/colorOnSurface</item>
    </style>

    <style name="SectionTitle">
        <item name="android:textAppearance">@style/TextAppearance.QuickTap.Title</item>
        <item name="android:textColor">?attr/colorOnSurface</item>
    </style>

    <style name="Overline">
        <item name="android:textAppearance">@style/TextAppearance.QuickTap.Overline</item>
        <item name="android:textColor">?attr/colorOnSurfaceVariant</item>
    </style>

    <style name="Caption">
        <item name="android:textSize">12sp</item>
        <item name="android:textColor">?attr/colorOnSurfaceVariant</item>
    </style>

    <style name="FieldLabel" parent="Overline">
        <item name="android:layout_marginTop">14dp</item>
    </style>

    <!-- ============================ CARDS ============================ -->
    <style name="CardPremium" parent="Widget.Material3.CardView.Outlined">
        <item name="cardCornerRadius">20dp</item>
        <item name="cardElevation">2dp</item>
        <item name="cardBackgroundColor">?attr/colorSurface</item>
        <item name="strokeColor">?attr/colorOutline</item>
        <item name="strokeWidth">1dp</item>
        <item name="rippleColor">@color/ripple_brand</item>
    </style>

    <style name="CardPremium.Flat" parent="CardPremium">
        <item name="cardBackgroundColor">?attr/colorSurfaceVariant</item>
        <item name="strokeWidth">0dp</item>
    </style>

    <style name="CardPremium.Hero" parent="CardPremium">
        <item name="cardCornerRadius">22dp</item>
        <item name="strokeWidth">0dp</item>
    </style>

    <style name="CardStat" parent="CardPremium">
        <item name="cardCornerRadius">16dp</item>
        <item name="cardElevation">0dp</item>
        <item name="strokeWidth">1dp</item>
        <item name="cardBackgroundColor">?attr/colorSurface</item>
    </style>

    <style name="CardBody">
        <item name="android:orientation">vertical</item>
        <item name="android:padding">18dp</item>
    </style>

    <!-- =========================== BUTTONS =========================== -->
    <style name="Button.QuickTap" parent="Widget.Material3.Button">
        <item name="android:minHeight">50dp</item>
        <item name="cornerRadius">16dp</item>
        <item name="android:letterSpacing">0</item>
        <item name="android:textAppearance">@style/TextAppearance.QuickTap.Label</item>
        <item name="elevation">0dp</item>
    </style>

    <style name="Button.QuickTap.Outlined" parent="Widget.Material3.Button.OutlinedButton">
        <item name="android:minHeight">50dp</item>
        <item name="cornerRadius">16dp</item>
        <item name="strokeWidth">1dp</item>
        <item name="strokeColor">?attr/colorOutline</item>
        <item name="android:textColor">?attr/colorOnSurface</item>
        <item name="iconTint">?attr/colorOnSurface</item>
        <item name="android:textAppearance">@style/TextAppearance.QuickTap.Label</item>
    </style>

    <style name="BigButton" parent="Widget.Material3.Button">
        <item name="android:minHeight">56dp</item>
        <item name="cornerRadius">18dp</item>
        <item name="android:textSize">15sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:letterSpacing">0</item>
        <item name="android:paddingStart">20dp</item>
        <item name="android:paddingEnd">20dp</item>
        <item name="elevation">0dp</item>
        <item name="iconPadding">8dp</item>
    </style>

    <style name="BigButton.Accent" parent="BigButton">
        <item name="backgroundTint">@color/brand_accent</item>
        <item name="android:textColor">@color/text_on_brand</item>
        <item name="iconTint">@color/text_on_brand</item>
    </style>

    <style name="BigButton.Tonal" parent="Widget.Material3.Button.TonalButton">
        <item name="android:minHeight">54dp</item>
        <item name="cornerRadius">16dp</item>
        <item name="android:textSize">15sp</item>
        <item name="android:textStyle">bold</item>
    </style>

    <style name="QuietButton" parent="Widget.Material3.Button.TextButton">
        <item name="android:minHeight">44dp</item>
        <item name="cornerRadius">10dp</item>
        <item name="android:textAppearance">@style/TextAppearance.QuickTap.Label</item>
    </style>

    <!-- ============================ INPUTS ============================ -->
    <style name="Input.QuickTap" parent="Widget.Material3.TextInputLayout.OutlinedBox">
        <item name="boxCornerRadiusTopStart">14dp</item>
        <item name="boxCornerRadiusTopEnd">14dp</item>
        <item name="boxCornerRadiusBottomStart">14dp</item>
        <item name="boxCornerRadiusBottomEnd">14dp</item>
        <item name="boxStrokeWidth">1dp</item>
        <item name="boxStrokeWidthFocused">2dp</item>
        <item name="hintTextColor">?attr/colorPrimary</item>
    </style>

    <!-- ============================= CHIPS ============================ -->
    <style name="Chip.QuickTap" parent="Widget.Material3.Chip.Filter">
        <item name="chipCornerRadius">6dp</item>
        <item name="chipMinHeight">36dp</item>
        <item name="chipBackgroundColor">@color/chip_bg_tint</item>
        <item name="android:textColor">@color/chip_text_tint</item>
        <item name="chipStrokeWidth">1dp</item>
        <item name="checkedIconVisible">false</item>
        <item name="chipStartPadding">12dp</item>
        <item name="chipEndPadding">12dp</item>
        <item name="android:textAppearance">@style/TextAppearance.QuickTap.Label</item>
        <item name="chipStrokeColor">?attr/colorOutline</item>
    </style>

    <!-- =========================== BOTTOM NAV ========================= -->
    <style name="BottomNav.QuickTap" parent="Widget.Material3.BottomNavigationView">
        <item name="android:background">@android:color/transparent</item>
        <item name="itemActiveIndicatorStyle">@style/BottomNav.QuickTap.Indicator</item>
        <item name="itemIconTint">@color/nav_item_tint</item>
        <item name="itemTextColor">@color/nav_item_tint</item>
        <item name="itemIconSize">@dimen/nav_icon_size</item>
        <item name="itemPaddingTop">6dp</item>
        <item name="itemPaddingBottom">6dp</item>
        <item name="itemRippleColor">@color/ripple_brand</item>
        <item name="itemTextAppearanceActive">@style/TextAppearance.QuickTap.NavLabel.Active</item>
        <item name="itemTextAppearanceInactive">@style/TextAppearance.QuickTap.NavLabel</item>
        <item name="elevation">0dp</item>
        <item name="labelVisibilityMode">labeled</item>
    </style>

    <style name="TextAppearance.QuickTap.NavLabel" parent="TextAppearance.Material3.LabelSmall">
        <item name="android:fontFamily">sans-serif-medium</item>
        <item name="android:textSize">@dimen/nav_label_size</item>
        <item name="android:letterSpacing">0</item>
    </style>

    <style name="TextAppearance.QuickTap.NavLabel.Active" parent="TextAppearance.QuickTap.NavLabel">
        <item name="android:textStyle">bold</item>
    </style>

    <style name="BottomNav.QuickTap.Indicator" parent="Widget.Material3.BottomNavigationView.ActiveIndicator">
        <item name="android:color">@color/nav_indicator</item>
        <item name="android:width">@dimen/nav_indicator_width</item>
        <item name="android:height">@dimen/nav_indicator_height</item>
        <item name="shapeAppearance">@style/Shape.QuickTap.Small</item>
    </style>

    <!-- ============================ LAYOUT ============================ -->
    <style name="ScreenPad">
        <item name="android:paddingStart">@dimen/screen_gutter</item>
        <item name="android:paddingEnd">@dimen/screen_gutter</item>
        <item name="android:paddingTop">18dp</item>
        <item name="android:clipToPadding">false</item>
    </style>

    <style name="EmptyState">
        <item name="android:background">@drawable/bg_glass_card</item>
        <item name="android:gravity">center</item>
        <item name="android:paddingVertical">40dp</item>
        <item name="android:paddingHorizontal">28dp</item>
        <item name="android:textSize">13sp</item>
        <item name="android:lineSpacingExtra">4dp</item>
        <item name="android:drawablePadding">14dp</item>
        <item name="drawableTint">?attr/colorPrimary</item>
        <item name="android:textColor">?attr/colorOnSurfaceVariant</item>
    </style>

    <style name="StatLabel" parent="Overline" />

    <style name="StatValue">
        <item name="android:textAppearance">@style/TextAppearance.QuickTap.类053</item>
        <item name="android:textColor">?attr/colorOnSurface</item>
        <item name="android:layout_marginTop">4dp</item>
        <item name="android:maxLines">1</item>
    </style>

    <!-- Premium top app bar -->
    <style name="Toolbar.QuickTap" parent="Widget.Material3.Toolbar">
        <item name="android:background">@color/brand_primary</item>
        <item name="titleTextAppearance">@style/TextAppearance.QuickTap.Title</item>
        <item name="subtitleTextAppearance">@style/TextAppearance.QuickTap.Overline</item>
        <item name="titleTextColor">@color/white</item>
        <item name="subtitleTextColor">@color/white</item>
        <item name="navigationIconTint">@color/white</item>
        <item name="titleCentered">true</item>
        <item name="subtitleCentered">true</item>
    </style>

    <!-- Navigation drawer -->
    <!-- Navigation drawer: Material 3 pill rows, generous rhythm, brand highlight. -->
    <style name="Drawer.QuickTap" parent="Widget.Material3.NavigationView">
        <item name="android:background">?attr/colorSurface</item>
        <item name="itemTextAppearance">@style/TextAppearance.QuickTap.Drawer</item>
        <item name="itemTextColor">@color/drawer_item_text</item>
        <item name="itemIconTint">@color/drawer_item_text</item>
        <item name="itemIconSize">25dp</item>
        <item name="itemIconPadding">14dp</item>
        <item name="itemHorizontalPadding">18dp</item>
        <item name="itemVerticalPadding">11dp</item>
        <item name="itemShapeInsetStart">8dp</item>
        <item name="itemShapeInsetEnd">8dp</item>
        <item name="itemShapeInsetTop">4dp</item>
        <item name="itemShapeInsetBottom">4dp</item>
        <item name="itemBackground">@drawable/bg_drawer_row</item>
        <item name="subheaderTextAppearance">@style/TextAppearance.QuickTap.Overline</item>
        <item name="subheaderColor">?attr/colorOnSurfaceVariant</item>
        <item name="subheaderInsetStart">18dp</item>
        <item name="dividerInsetStart">18dp</item>
        <item name="dividerInsetEnd">18dp</item>
        <item name="elevation">0dp</item>
    </style>

    <style name="Shape.QuickTap.Drawer" parent="ShapeAppearance.Material3.Corner.Full">
        <item name="cornerSize">26dp</item>
    </style>

    <style name="TextAppearance.QuickTap.Drawer" parent="TextAppearance.Material3.LabelLarge">
        <item name="android:fontFamily">sans-serif-medium</item>
        <item name="android:textSize">15sp</item>
        <item name="android:letterSpacing">0.01</item>
    </style>
    <!-- Bottom checkout panel: rounded top corners only. -->
    <style name="Shape.QuickTap.TopRounded" parent="">
        <item name="cornerFamily">rounded</item>
        <item name="cornerSizeTopLeft">22dp</item>
        <item name="cornerSizeTopRight">22dp</item>
        <item name="cornerSizeBottomLeft">0dp</item>
        <item name="cornerSizeBottomRight">0dp</item>
    </style>
</resources>
